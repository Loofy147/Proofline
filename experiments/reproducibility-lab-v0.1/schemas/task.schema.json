{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vap/task-v0.1.schema.json",
  "title": "VAP Task Commitment Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "runtime_profile", "verification_policy"],
  "properties": {
    "schema_version": {"const": "vap.task.v0.1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "image", "network", "read_only_rootfs", "cap_drop", "tmpfs_mb", "limits", "command"],
      "properties": {
        "engine": {"const": "podman-rootless"},
        "image": {"type": "string", "pattern": "^(localhost|[A-Za-z0-9.-]+(:[0-9]{1,5})?)/[A-Za-z0-9._/:+-]+@sha256:[0-9a-f]{64}$"},
        "network": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "cap_drop": {"const": ["ALL"]},
        "tmpfs_mb": {"type": "integer", "minimum": 1, "maximum": 128},
        "command": {"description": "Direct argv only. Shell entrypoints and inline-code flags are additionally rejected by the normative application validator.", "type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_seconds", "memory_mb", "cpus", "pids_max", "max_output_bytes", "max_input_bytes", "max_source_bytes", "max_source_files"],
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
            "memory_mb": {"type": "integer", "minimum": 64, "maximum": 8192},
            "cpus": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"},
            "pids_max": {"type": "integer", "minimum": 16, "maximum": 1024},
            "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 16777216},
            "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "max_source_bytes": {"type": "integer", "minimum": 1024, "maximum": 536870912},
            "max_source_files": {"type": "integer", "minimum": 1, "maximum": 50000}
          }
        }
      }
    },
    "verification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealed_test_hash", "protocol"],
      "properties": {
        "sealed_test_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "protocol": {"const": "stdin_stdout_exact_v1"}
      }
    }
  }
}
